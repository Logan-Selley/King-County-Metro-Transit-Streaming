# dbt, in its own image. Never in the project venv and never in Airflow's.
#
# pyproject.toml explains the venv half: dbt-core drags in a resolver
# constraint set that has nothing to do with ingest. The Airflow half is the
# parcel project's lesson, reused rather than relearned: Airflow and dbt pin
# overlapping libraries differently, so Airflow runs this image as a sibling
# container (DockerOperator) instead of importing dbt.
#
# Pinned exactly. dbt-postgres 1.11.0 is the newest adapter as of
# 2026-09-23; the adapter and dbt-core have versioned independently since
# 1.8, so the core version is whatever this pin resolves to and is printed by
# `dbt --version` at build time rather than asserted here.
FROM python:3.12-slim

RUN pip install --no-cache-dir dbt-postgres==1.11.0 \
 && dbt --version

WORKDIR /dbt
ENTRYPOINT ["dbt"]
