# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# docker-compose.yml reads this file implicitly for ${VAR} substitution.
# Python reads it via python-dotenv. dbt (Phase 4) will NOT read it --
# env_var() reads the process environment, so the Makefile sources it first.
#
# To source it by hand, note that the obvious fish one-liner
# `export (cat .env | grep -v '^#')` does NOT work: blank lines produce an
# empty element and fish's export rejects it. In fish:
#
#   for l in (grep -vE '^#|^$' .env); set -gx (string split -m1 = $l); end
#
# In bash/zsh:  set -a; . ./.env; set +a

# --- ports ------------------------------------------------------------------
# All of these route around the parcel project, which holds 5433 and 8080.
# Change them here rather than in docker-compose.yml.
REDPANDA_KAFKA_PORT=19092
REDPANDA_REGISTRY_PORT=18081
REDPANDA_PROXY_PORT=18082
REDPANDA_ADMIN_PORT=19644
CONSOLE_PORT=8085
WAREHOUSE_PORT=5434
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CONNECT_PORT=8083

# --- kafka ------------------------------------------------------------------
# Host-side clients use localhost:19092. Anything running INSIDE the compose
# network uses redpanda:9092 instead -- see the listener comment in
# docker-compose.yml before changing either.
KAFKA_BOOTSTRAP=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:18081

# --- warehouse --------------------------------------------------------------
POSTGRES_USER=transit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=transit
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5434

# --- raw archive ------------------------------------------------------------
# MinIO's root credentials. Real deployments would issue a scoped access key
# for the producer; for a local single-tenant stack the root user is the
# whole point of MinIO being a development stand-in for S3.
MINIO_ROOT_USER=transit
MINIO_ROOT_PASSWORD=change-me-too
MINIO_ENDPOINT=localhost:9000
RAW_BUCKET=transit-raw

# --- feed polling -----------------------------------------------------------
# Per-feed intervals, because the feeds do not move at the same rate.
#
# MEASURED, not guessed (docs/findings.md §2): positions and trip updates both
# republish every 20.0s -- in lockstep, from what is evidently one upstream
# job -- and alerts every 60.0s. The proposal's 15-30s estimate was close for
# the first two and wrong about alerts being irregular.
#
# These are set to HALF the observed publish period. Polling *at* the period
# risks phase-locking just behind the publisher and seeing every version a
# full period late; polling at half of it bounds detection latency to one
# interval. The extra requests are conditional and return 304 with a few
# hundred bytes, which is the entire reason for doing conditional GET.
POLL_INTERVAL_VEHICLE_POSITIONS=10
POLL_INTERVAL_TRIP_UPDATES=10
POLL_INTERVAL_SERVICE_ALERTS=30

# Sent on every request to the King County S3 endpoints. This is an
# unauthenticated public feed run by a transit agency; identifying the client
# and leaving a contact address is the difference between being a good citizen
# and being the reason they add a rate limit.
#
# QUOTED, and it has to be. Docker Compose parses .env itself and does not
# care, but the Makefile sources this file with `set -a; . ./.env; set +a`,
# and bash chokes on the unquoted parentheses:
#     .env: line 66: syntax error near unexpected token `('
# Compose strips the surrounding quotes, so quoting satisfies both readers.
FEED_USER_AGENT="transit-stream/0.1 (portfolio project; contact: archane24@gmail.com)"
