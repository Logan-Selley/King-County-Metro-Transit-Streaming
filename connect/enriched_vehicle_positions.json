{
  "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
  "tasks.max": "3",
  "topics": "enriched.vehicle_positions",
  "connection.url": "jdbc:postgresql://warehouse:5432/${env:POSTGRES_DB}",
  "connection.user": "${env:POSTGRES_USER}",
  "connection.password": "${env:POSTGRES_PASSWORD}",
  "table.name.format": "raw.enriched_vehicle_positions",
  "auto.create": "false",
  "auto.evolve": "false",
  "table.types": "PARTITIONED TABLE",
  "insert.mode": "upsert",
  "pk.mode": "record_value",
  "pk.fields": "vehicle_id,position_timestamp",
  "batch.size": "3000",
  "transforms": "positionTs,enrichedTs",
  "transforms.positionTs.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
  "transforms.positionTs.field": "position_timestamp",
  "transforms.positionTs.target.type": "Timestamp",
  "transforms.positionTs.unix.precision": "seconds",
  "transforms.enrichedTs.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
  "transforms.enrichedTs.field": "enriched_at",
  "transforms.enrichedTs.target.type": "Timestamp",
  "transforms.enrichedTs.unix.precision": "seconds",
  "errors.tolerance": "none",
  "errors.log.enable": "true",
  "consumer.override.auto.offset.reset": "earliest"
}
