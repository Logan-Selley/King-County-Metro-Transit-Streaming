{
  "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
  "tasks.max": "3",
  "topics": "analytics.prediction_accuracy",
  "connection.url": "jdbc:postgresql://warehouse:5432/${env:POSTGRES_DB}",
  "connection.user": "connect_sink",
  "connection.password": "${env:CONNECT_SINK_PASSWORD}",
  "table.name.format": "raw.prediction_accuracy",
  "auto.create": "false",
  "auto.evolve": "false",
  "table.types": "PARTITIONED TABLE",
  "insert.mode": "upsert",
  "pk.mode": "record_value",
  "pk.fields": "start_date,trip_id,stop_id,issued_at,observed_at",
  "batch.size": "3000",
  "transforms": "issuedTs,predictedTs,observedTs",
  "transforms.issuedTs.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
  "transforms.issuedTs.field": "issued_at",
  "transforms.issuedTs.target.type": "Timestamp",
  "transforms.issuedTs.unix.precision": "seconds",
  "transforms.predictedTs.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
  "transforms.predictedTs.field": "predicted_arrival",
  "transforms.predictedTs.target.type": "Timestamp",
  "transforms.predictedTs.unix.precision": "seconds",
  "transforms.observedTs.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
  "transforms.observedTs.field": "observed_at",
  "transforms.observedTs.target.type": "Timestamp",
  "transforms.observedTs.unix.precision": "seconds",
  "errors.tolerance": "none",
  "errors.log.enable": "true",
  "consumer.override.auto.offset.reset": "earliest",
  "value.converter": "io.confluent.connect.json.JsonSchemaConverter",
  "value.converter.schema.registry.url": "http://redpanda:8081",
  "value.converter.schemas.enable": "true"
}
