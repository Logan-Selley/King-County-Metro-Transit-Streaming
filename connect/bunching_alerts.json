{
  "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
  "tasks.max": "1",
  "topics": "alerts.bunching",
  "connection.url": "jdbc:postgresql://warehouse:5432/${env:POSTGRES_DB}",
  "connection.user": "connect_sink",
  "connection.password": "${env:CONNECT_SINK_PASSWORD}",
  "table.name.format": "raw.bunching_alerts",
  "auto.create": "false",
  "auto.evolve": "false",
  "table.types": "PARTITIONED TABLE",
  "insert.mode": "upsert",
  "pk.mode": "record_value",
  "pk.fields": "vehicle_id_a,vehicle_id_b,window_end",
  "batch.size": "3000",
  "transforms": "windowTs",
  "transforms.windowTs.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
  "transforms.windowTs.field": "window_end",
  "transforms.windowTs.target.type": "Timestamp",
  "transforms.windowTs.unix.precision": "seconds",
  "errors.tolerance": "none",
  "errors.log.enable": "true",
  "consumer.override.auto.offset.reset": "earliest",
  "value.converter": "io.confluent.connect.json.JsonSchemaConverter",
  "value.converter.schema.registry.url": "http://redpanda:8081",
  "value.converter.schemas.enable": "true"
}
